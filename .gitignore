# MCP config contains API tokens
.claude/mcp.json

# macOS artifacts
.DS_Store

# Intermediate build files
meetings/**/*.html

# Podcast prep PDFs — generated on demand from MD source, never committed
meetings/podcast-prep/*.pdf

# FUSE mount artifacts
.fuse_hidden*
**/.fuse_hidden*

# Photo pipeline working data
data/photo-pipeline/

# Wine monitor log
systems/wine-monitor/data/daemon.log

# Political monitor transient build files (regenerated each run)
systems/political-monitor/harvest.json
systems/political-monitor/clusters.json

# Local secrets (tokens, credentials — never committed)
config/.env
config/.credentials
systems/sandbox-credentials/.git-credentials

# Compiled binaries
bridge/send-to-desktop

# Playwright MCP browser data
.playwright-mcp/

# Node.js
node_modules/
dist/

# Python bytecode cache
__pycache__/
*.pyc

# Debug screenshots
debug-app.png
debug-settings.png
screenshot.png

# Skill eval evidence — personal/local-only, never published
# Contains user-specific eval prompts, executor transcripts, and feedback
systems/evals/work-*/evals/
systems/evals/work-*/iteration-*/
systems/evals/work-*/skill-snapshot/
systems/evals/work-*/description-tuning/
