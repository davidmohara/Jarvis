{
  "name": "pipeline-review",
  "type": "workflow",
  "assertions": [
    {
      "id": "pipe-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/pipeline-review/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Pipeline review workflow state.yaml shows status: complete"
    },
    {
      "id": "pipeline_rev-wm-written",
      "check": "file_exists",
      "path": "memory/working/pipeline-review-*.md",
      "description": "Pipeline review working memory file was written to memory/working/"
    },
    {
      "id": "pipeline_rev-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/pipeline-review-*.md",
      "min_bytes": 200,
      "description": "Pipeline review working memory file is substantive (>200 bytes)"
    },
    {
      "id": "pipeline_rev-wm-content",
      "check": "file_contains",
      "path": "memory/working/pipeline-review-*.md",
      "pattern": "(?i)(pipeline|deal|revenue)",
      "description": "Pipeline review working memory contains expected content"
    }
  ]
}