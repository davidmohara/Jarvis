{
  "name": "session-index",
  "type": "skill",
  "assertions": [
    {
      "id": "session-index-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/session-index-latest.json",
      "description": "session-index skill-run signal file was written"
    },
    {
      "id": "session-index-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/session-index-latest.json",
      "field": "status",
      "value": "failure",
      "description": "session-index skill-run did not end in failure"
    },
    {
      "id": "session--002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/session-index-*.md",
      "min_bytes": 200,
      "description": "session-index output is substantive (>200 bytes)"
    },
    {
      "id": "session--003-content",
      "check": "file_contains",
      "path": "memory/working/session-index-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "session-index output contains expected content"
    }
  ]
}