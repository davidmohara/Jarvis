{
  "name": "new-clients",
  "type": "skill",
  "assertions": [
    {
      "id": "new-clients-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/new-clients-latest.json",
      "description": "new-clients skill-run signal file was written"
    },
    {
      "id": "new-clients-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/new-clients-latest.json",
      "field": "status",
      "value": "failure",
      "description": "new-clients skill-run did not end in failure"
    },
    {
      "id": "new-clients-wm-written",
      "check": "file_exists",
      "path": "memory/working/new-clients-*.md",
      "description": "new-clients working memory file written to memory/working/"
    },
    {
      "id": "new-clients-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/new-clients-*.md",
      "min_bytes": 200,
      "description": "new-clients working memory file is substantive (>200 bytes)"
    },
    {
      "id": "new-clients-wm-content",
      "check": "file_contains",
      "path": "memory/working/new-clients-*.md",
      "pattern": "(?i)(client|logo|anchor)",
      "description": "new-clients working memory contains expected content"
    }
  ]
}