{
  "name": "chase-account",
  "type": "skill",
  "assertions": [
    {
      "id": "chase-account-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/chase-account-latest.json",
      "description": "chase-account skill-run signal file was written"
    },
    {
      "id": "chase-account-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/chase-account-latest.json",
      "field": "status",
      "value": "failure",
      "description": "chase-account skill-run did not end in failure"
    },
    {
      "id": "chase-account-wm-written",
      "check": "file_exists",
      "path": "memory/working/account-strategy-*.md",
      "description": "chase-account working memory file written to memory/working/"
    },
    {
      "id": "chase-account-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/account-strategy-*.md",
      "min_bytes": 200,
      "description": "chase-account working memory file is substantive (>200 bytes)"
    },
    {
      "id": "chase-account-wm-content",
      "check": "file_contains",
      "path": "memory/working/account-strategy-*.md",
      "pattern": "(?i)(account|strategy|play)",
      "description": "chase-account working memory contains expected content"
    }
  ]
}