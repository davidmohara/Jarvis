{
  "name": "podcast-transcript-extract",
  "type": "skill",
  "assertions": [
    {
      "id": "signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/podcast-transcript-extract-latest.json",
      "description": "Skill-run signal file was written"
    },
    {
      "id": "signal-not-failure",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/podcast-transcript-extract-latest.json",
      "field": "status",
      "value": "failure",
      "description": "Skill-run signal status is not 'failure'"
    },
    {
      "id": "vault-file-exists",
      "check": "file_exists",
      "path": "Podcasts/*.md",
      "description": "A transcript note was written to the vault (Podcasts/ directory)"
    },
    {
      "id": "vault-file-min-bytes",
      "check": "file_min_bytes",
      "path": "Podcasts/*.md",
      "min_bytes": 1000,
      "description": "Transcript note is substantive — not a stub"
    },
    {
      "id": "has-transcript-heading",
      "check": "file_contains",
      "path": "Podcasts/*.md",
      "pattern": "## (Transcript|Full Transcript)",
      "description": "Note contains a Transcript section heading"
    },
    {
      "id": "filename-date-convention",
      "check": "file_exists",
      "path": "Podcasts/[0-9][0-9]-[0-9][0-9]-[0-9][0-9] - *.md",
      "description": "Filename follows {YY-MM-DD} - {Show Name} - {Episode Title}.md convention"
    },
    {
      "id": "no-empty-transcript",
      "check": "file_not_contains",
      "path": "Podcasts/*.md",
      "pattern": "## Transcript\\s*\\n\\s*\\n##",
      "description": "Transcript section is not empty (no heading immediately followed by next heading)"
    },
    {
      "id": "podcast--002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/podcast-transcript-extract-*.md",
      "min_bytes": 200,
      "description": "podcast-transcript-extract output is substantive (>200 bytes)"
    },
    {
      "id": "podcast--003-content",
      "check": "file_contains",
      "path": "memory/working/podcast-transcript-extract-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "podcast-transcript-extract output contains expected content"
    }
  ]
}