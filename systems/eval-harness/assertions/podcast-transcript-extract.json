{
  "name": "podcast-transcript-extract",
  "type": "skill",
  "assertions": [
    {
      "id": "podcast-transcript-extract-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/podcast-transcript-extract-latest.json",
      "description": "podcast-transcript-extract skill-run signal file was written"
    },
    {
      "id": "podcast-transcript-extract-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/podcast-transcript-extract-latest.json",
      "field": "status",
      "value": "failure",
      "description": "podcast-transcript-extract skill-run did not end in failure"
    },
    {
      "id": "podcast--002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/podcast-transcript-extract-*.md",
      "min_bytes": 200,
      "description": "podcast-transcript-extract output is substantive (>200 bytes)"
    },
    {
      "id": "podcast--003-content",
      "check": "file_contains",
      "path": "memory/working/podcast-transcript-extract-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "podcast-transcript-extract output contains expected content"
    }
  ]
}