{
  "name": "harper-email-coaching",
  "type": "skill",
  "assertions": [
    {
      "id": "harper-email-coaching-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/harper-email-coaching-latest.json",
      "description": "harper-email-coaching skill-run signal file was written"
    },
    {
      "id": "harper-email-coaching-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/harper-email-coaching-latest.json",
      "field": "status",
      "value": "failure",
      "description": "harper-email-coaching skill-run did not end in failure"
    },
    {
      "id": "harper-e-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/harper-email-coaching-*.md",
      "min_bytes": 200,
      "description": "harper-email-coaching output is substantive (>200 bytes)"
    },
    {
      "id": "harper-e-003-content",
      "check": "file_contains",
      "path": "memory/working/harper-email-coaching-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "harper-email-coaching output contains expected content"
    }
  ]
}