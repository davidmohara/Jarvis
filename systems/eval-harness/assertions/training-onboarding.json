{
  "name": "training-onboarding",
  "type": "workflow",
  "assertions": [
    {
      "id": "trainonboard-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/training-onboarding/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Training onboarding workflow state.yaml shows status: complete"
    },
    {
      "id": "training-001-exists",
      "check": "file_exists",
      "path": "memory/working/training-onboarding-*.md",
      "description": "training-onboarding output file was written"
    },
    {
      "id": "training-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/training-onboarding-*.md",
      "min_bytes": 200,
      "description": "training-onboarding output is substantive (>200 bytes)"
    },
    {
      "id": "training-003-content",
      "check": "file_contains",
      "path": "memory/working/training-onboarding-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "training-onboarding output contains expected content"
    }
  ]
}