{
  "name": "knox-vault-health",
  "type": "skill",
  "assertions": [
    {
      "id": "knox-vault-health-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/knox-vault-health-latest.json",
      "description": "knox-vault-health skill-run signal file was written"
    },
    {
      "id": "knox-vault-health-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/knox-vault-health-latest.json",
      "field": "status",
      "value": "failure",
      "description": "knox-vault-health skill-run did not end in failure"
    },
    {
      "id": "knox-vault-health-wm-written",
      "check": "file_exists",
      "path": "memory/working/vault-health-*.md",
      "description": "knox-vault-health working memory file written to memory/working/"
    },
    {
      "id": "knox-vault-health-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/vault-health-*.md",
      "min_bytes": 200,
      "description": "knox-vault-health working memory file is substantive (>200 bytes)"
    },
    {
      "id": "knox-vault-health-wm-content",
      "check": "file_contains",
      "path": "memory/working/vault-health-*.md",
      "pattern": "(?i)(vault|health|issue)",
      "description": "knox-vault-health working memory contains expected content"
    }
  ]
}