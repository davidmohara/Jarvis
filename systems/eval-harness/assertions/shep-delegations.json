{
  "name": "shep-delegations",
  "type": "skill",
  "assertions": [
    {
      "id": "shep-delegations-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/shep-delegations-latest.json",
      "description": "shep-delegations skill-run signal file was written"
    },
    {
      "id": "shep-delegations-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/shep-delegations-latest.json",
      "field": "status",
      "value": "failure",
      "description": "shep-delegations skill-run did not end in failure"
    },
    {
      "id": "shep-del-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/shep-delegations-*.md",
      "min_bytes": 200,
      "description": "shep-delegations output is substantive (>200 bytes)"
    },
    {
      "id": "shep-del-003-content",
      "check": "file_contains",
      "path": "memory/working/shep-delegations-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "shep-delegations output contains expected content"
    }
  ]
}