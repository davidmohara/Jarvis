{
  "name": "one-on-one-prep",
  "type": "workflow",
  "assertions": [
    {
      "id": "ooo-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/one-on-one-prep/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "One-on-one prep workflow state.yaml shows status: complete"
    },
    {
      "id": "one-on-o-001-exists",
      "check": "file_exists",
      "path": "memory/working/one-on-one-prep-*.md",
      "description": "one-on-one-prep output file was written"
    },
    {
      "id": "one-on-o-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/one-on-one-prep-*.md",
      "min_bytes": 200,
      "description": "one-on-one-prep output is substantive (>200 bytes)"
    },
    {
      "id": "one-on-o-003-content",
      "check": "file_contains",
      "path": "memory/working/one-on-one-prep-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "one-on-one-prep output contains expected content"
    },
    {
      "id": "ooo-002-adversarial-verification-ran",
      "check": "guardrail_checkpoint_ran",
      "checkpoint_name": "adversarial-verification",
      "category": "quality",
      "description": "Stage 5 Phase 4A: step-06 spawns Ralph (one-on-one-prep-verification workflow) and records an 'adversarial-verification' guardrail result on this run. Read from the eval record's own guardrails array. A separate agent cross-checks the brief's open action items and talking points against the delegation tracker and OmniFocus records."
    }
  ]
}