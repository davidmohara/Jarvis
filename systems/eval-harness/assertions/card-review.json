{
  "name": "card-review",
  "type": "workflow",
  "assertions": [
    {
      "id": "cardrev-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/card-review/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Card review workflow state.yaml shows status: complete"
    },
    {
      "id": "card-rev-001-exists",
      "check": "file_exists",
      "path": "memory/working/card-review-*.md",
      "description": "card-review output file was written"
    },
    {
      "id": "card-rev-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/card-review-*.md",
      "min_bytes": 200,
      "description": "card-review output is substantive (>200 bytes)"
    },
    {
      "id": "card-rev-003-content",
      "check": "file_contains",
      "path": "memory/working/card-review-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "card-review output contains expected content"
    }
  ]
}