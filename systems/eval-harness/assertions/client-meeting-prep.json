{
  "name": "client-meeting-prep",
  "type": "workflow",
  "assertions": [
    {
      "id": "cmp-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/client-meeting-prep/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Client meeting prep workflow state.yaml shows status: complete"
    },
    {
      "id": "client-m-001-exists",
      "check": "file_exists",
      "path": "memory/working/client-meeting-prep-*.md",
      "description": "client-meeting-prep output file was written"
    },
    {
      "id": "client-m-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/client-meeting-prep-*.md",
      "min_bytes": 200,
      "description": "client-meeting-prep output is substantive (>200 bytes)"
    },
    {
      "id": "client-m-003-content",
      "check": "file_contains",
      "path": "memory/working/client-meeting-prep-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "client-meeting-prep output contains expected content"
    },
    {
      "id": "cmp-002-adversarial-verification-ran",
      "check": "guardrail_checkpoint_ran",
      "checkpoint_name": "adversarial-verification",
      "category": "quality",
      "description": "Stage 5 Phase 4A: step-06 spawns Ralph (client-meeting-prep-verification workflow) and records an 'adversarial-verification' guardrail result on this run. Read from the eval record's own guardrails array. This is the distinct-lens check Tim's Stage 5 finding requires: a separate agent tracing every attendee/company fact in the prep sheet back to calendar, email, or CRM source data."
    }
  ]
}