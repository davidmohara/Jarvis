{
  "name": "quinn-weekly-review",
  "type": "skill",
  "assertions": [
    {
      "id": "quinn-weekly-review-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/quinn-weekly-review-latest.json",
      "description": "quinn-weekly-review skill-run signal file was written"
    },
    {
      "id": "quinn-weekly-review-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/quinn-weekly-review-latest.json",
      "field": "status",
      "value": "failure",
      "description": "quinn-weekly-review skill-run did not end in failure"
    },
    {
      "id": "quinn-weekly-review-wm-written",
      "check": "file_exists",
      "path": "memory/working/weekly-review-prep-*.md",
      "description": "quinn-weekly-review working memory file written to memory/working/"
    },
    {
      "id": "quinn-weekly-review-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/weekly-review-prep-*.md",
      "min_bytes": 200,
      "description": "quinn-weekly-review working memory file is substantive (>200 bytes)"
    },
    {
      "id": "quinn-weekly-review-wm-content",
      "check": "file_contains",
      "path": "memory/working/weekly-review-prep-*.md",
      "pattern": "(?i)(rock|week|review)",
      "description": "quinn-weekly-review working memory contains expected content"
    }
  ]
}