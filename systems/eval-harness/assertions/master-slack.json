{
  "name": "master-slack",
  "type": "skill",
  "assertions": [
    {
      "id": "master-slack-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/master-slack-latest.json",
      "description": "master-slack skill-run signal file was written"
    },
    {
      "id": "master-slack-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/master-slack-latest.json",
      "field": "status",
      "value": "failure",
      "description": "master-slack skill-run did not end in failure"
    },
    {
      "id": "master-s-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/master-slack-*.md",
      "min_bytes": 200,
      "description": "master-slack output is substantive (>200 bytes)"
    },
    {
      "id": "master-s-003-content",
      "check": "file_contains",
      "path": "memory/working/master-slack-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "master-slack output contains expected content"
    }
  ]
}