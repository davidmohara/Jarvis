{
  "name": "daily-review",
  "type": "workflow",
  "assertions": [
    {
      "id": "daily-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/daily-review/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Daily review workflow state.yaml shows status: complete"
    },
    {
      "id": "daily-002-review-written",
      "check": "file_exists",
      "path": "reviews/daily/????-??-??.md",
      "description": "Daily review output file was written to reviews/daily/"
    },
    {
      "id": "daily-003-review-substantive",
      "check": "file_min_bytes",
      "path": "reviews/daily/????-??-??.md",
      "min_bytes": 300,
      "description": "Daily review output is substantive (>300 bytes)"
    },
    {
      "id": "daily-004-priorities-section",
      "check": "file_contains",
      "path": "reviews/daily/????-??-??.md",
      "pattern": "(?i)(priorit|tomorrow|tomorrow's|next)",
      "description": "Daily review contains priorities or next-day planning section"
    },
    {
      "id": "daily-005-shutdown-section",
      "check": "file_contains",
      "path": "reviews/daily/????-??-??.md",
      "pattern": "(?i)(completed|done|accomplished|finished|wins)",
      "description": "Daily review contains completed items or wins section"
    },
    {
      "id": "daily_review-wm-written",
      "check": "file_exists",
      "path": "memory/working/daily-review-*.md",
      "description": "Daily review working memory file was written to memory/working/"
    },
    {
      "id": "daily_review-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/daily-review-*.md",
      "min_bytes": 200,
      "description": "Daily review working memory file is substantive (>200 bytes)"
    },
    {
      "id": "daily_review-wm-content",
      "check": "file_contains",
      "path": "memory/working/daily-review-*.md",
      "pattern": "(?i)(today|task|priority)",
      "description": "Daily review working memory contains expected content"
    }
  ]
}