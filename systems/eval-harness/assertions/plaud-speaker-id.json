{
  "name": "plaud-speaker-id",
  "type": "skill",
  "assertions": [
    {
      "id": "plaud-speaker-id-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/plaud-speaker-id-latest.json",
      "description": "plaud-speaker-id skill-run signal file was written"
    },
    {
      "id": "plaud-speaker-id-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/plaud-speaker-id-latest.json",
      "field": "status",
      "value": "failure",
      "description": "plaud-speaker-id skill-run did not end in failure"
    },
    {
      "id": "plaud-sp-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/plaud-speaker-id-*.md",
      "min_bytes": 200,
      "description": "plaud-speaker-id output is substantive (>200 bytes)"
    },
    {
      "id": "plaud-sp-003-content",
      "check": "file_contains",
      "path": "memory/working/plaud-speaker-id-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "plaud-speaker-id output contains expected content"
    }
  ]
}