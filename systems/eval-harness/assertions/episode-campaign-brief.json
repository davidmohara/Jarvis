{
  "name": "episode-campaign-brief",
  "type": "workflow",
  "assertions": [
    {
      "id": "epcb-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/episode-campaign-brief/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "episode-campaign-brief workflow state.yaml shows status: complete"
    },
    {
      "id": "epcb-002-wm-written",
      "check": "file_exists",
      "path": "memory/working/episode-campaign-brief-*.md",
      "description": "episode-campaign-brief working memory file was written to memory/working/"
    },
    {
      "id": "epcb-003-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/episode-campaign-brief-*.md",
      "min_bytes": 200,
      "description": "episode-campaign-brief working memory file is substantive (>200 bytes)"
    },
    {
      "id": "epcb-004-wm-content",
      "check": "file_contains",
      "path": "memory/working/episode-campaign-brief-*.md",
      "pattern": "(?i)(episode|campaign|brief)",
      "description": "episode-campaign-brief working memory contains expected content"
    }
  ]
}
