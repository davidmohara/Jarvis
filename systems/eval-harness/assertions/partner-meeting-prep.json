{
  "name": "partner-meeting-prep",
  "type": "workflow",
  "assertions": [
    {
      "id": "pmp-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/partner-meeting-prep/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Partner meeting prep workflow state.yaml shows status: complete"
    },
    {
      "id": "partner--001-exists",
      "check": "file_exists",
      "path": "memory/working/partner-meeting-prep-*.md",
      "description": "partner-meeting-prep output file was written"
    },
    {
      "id": "partner--002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/partner-meeting-prep-*.md",
      "min_bytes": 200,
      "description": "partner-meeting-prep output is substantive (>200 bytes)"
    },
    {
      "id": "partner--003-content",
      "check": "file_contains",
      "path": "memory/working/partner-meeting-prep-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "partner-meeting-prep output contains expected content"
    },
    {
      "id": "pmp-002-adversarial-verification-ran",
      "check": "guardrail_checkpoint_ran",
      "checkpoint_name": "adversarial-verification",
      "category": "quality",
      "description": "Stage 5 Phase 4A: step-05 spawns Ralph (partner-meeting-prep-verification workflow) and records an 'adversarial-verification' guardrail result on this run. Read from the eval record's own guardrails array. A separate agent cross-checks the account-overlap and event claims against the actual CRM, calendar, and email records."
    }
  ]
}