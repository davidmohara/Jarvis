{
  "name": "skill-optimize",
  "type": "workflow",
  "assertions": [
    {
      "id": "skop-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/skill-optimize/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "skill-optimize workflow state.yaml shows status: complete"
    },
    {
      "id": "skop-002-wm-written",
      "check": "file_exists",
      "path": "memory/working/skill-optimize-*.md",
      "description": "skill-optimize working memory file was written to memory/working/"
    },
    {
      "id": "skop-003-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/skill-optimize-*.md",
      "min_bytes": 200,
      "description": "skill-optimize working memory file is substantive (>200 bytes)"
    },
    {
      "id": "skop-004-wm-content",
      "check": "file_contains",
      "path": "memory/working/skill-optimize-*.md",
      "pattern": "(?i)(skill|reflect|optimi)",
      "description": "skill-optimize working memory contains expected content"
    }
  ]
}
