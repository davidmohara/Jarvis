{
  "name": "shutdown-cleanup",
  "type": "workflow",
  "assertions": [
    {
      "id": "shutdown-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/shutdown-cleanup/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Shutdown cleanup workflow state.yaml shows status: complete"
    },
    {
      "id": "shutdown_cle-wm-written",
      "check": "file_exists",
      "path": "memory/working/shutdown-cleanup-*.md",
      "description": "Shutdown cleanup working memory file was written to memory/working/"
    },
    {
      "id": "shutdown_cle-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/shutdown-cleanup-*.md",
      "min_bytes": 200,
      "description": "Shutdown cleanup working memory file is substantive (>200 bytes)"
    },
    {
      "id": "shutdown_cle-wm-content",
      "check": "file_contains",
      "path": "memory/working/shutdown-cleanup-*.md",
      "pattern": "(?i)(commit|cleanup|purge)",
      "description": "Shutdown cleanup working memory contains expected content"
    }
  ]
}