{
  "name": "rigby-evolution-upload",
  "type": "skill",
  "assertions": [
    {
      "id": "rigby-evolution-upload-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/rigby-evolution-upload-latest.json",
      "description": "rigby-evolution-upload skill-run signal file was written"
    },
    {
      "id": "rigby-evolution-upload-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/rigby-evolution-upload-latest.json",
      "field": "status",
      "value": "failure",
      "description": "rigby-evolution-upload skill-run did not end in failure"
    },
    {
      "id": "rigby-ev-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/rigby-evolution-upload-*.md",
      "min_bytes": 200,
      "description": "rigby-evolution-upload output is substantive (>200 bytes)"
    },
    {
      "id": "rigby-ev-003-content",
      "check": "file_contains",
      "path": "memory/working/rigby-evolution-upload-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "rigby-evolution-upload output contains expected content"
    }
  ]
}