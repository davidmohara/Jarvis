{
  "name": "golf-preview",
  "type": "skill",
  "assertions": [
    {
      "id": "golf-preview-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/golf-preview-latest.json",
      "description": "golf-preview skill-run signal file was written"
    },
    {
      "id": "golf-preview-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/golf-preview-latest.json",
      "field": "status",
      "value": "failure",
      "description": "golf-preview skill-run did not end in failure"
    },
    {
      "id": "golf-pre-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/golf-preview-*.md",
      "min_bytes": 200,
      "description": "golf-preview output is substantive (>200 bytes)"
    },
    {
      "id": "golf-pre-003-content",
      "check": "file_contains",
      "path": "memory/working/golf-preview-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "golf-preview output contains expected content"
    }
  ]
}