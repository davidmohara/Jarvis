{
  "name": "initiative-tracker",
  "type": "workflow",
  "assertions": [
    {
      "id": "init-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/initiative-tracker/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Initiative tracker workflow state.yaml shows status: complete"
    },
    {
      "id": "initiative_t-wm-written",
      "check": "file_exists",
      "path": "memory/working/initiative-tracker-*.md",
      "description": "Initiative tracker working memory file was written to memory/working/"
    },
    {
      "id": "initiative_t-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/initiative-tracker-*.md",
      "min_bytes": 200,
      "description": "Initiative tracker working memory file is substantive (>200 bytes)"
    },
    {
      "id": "initiative_t-wm-content",
      "check": "file_contains",
      "path": "memory/working/initiative-tracker-*.md",
      "pattern": "(?i)(initiative|block|owner)",
      "description": "Initiative tracker working memory contains expected content"
    }
  ]
}