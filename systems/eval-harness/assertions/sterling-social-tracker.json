{
  "name": "sterling-social-tracker",
  "type": "skill",
  "assertions": [
    {
      "id": "sterling-social-tracker-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/sterling-social-tracker-latest.json",
      "description": "sterling-social-tracker skill-run signal file was written"
    },
    {
      "id": "sterling-social-tracker-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/sterling-social-tracker-latest.json",
      "field": "status",
      "value": "failure",
      "description": "sterling-social-tracker skill-run did not end in failure"
    },
    {
      "id": "sterling-social-tracker-wm-written",
      "check": "file_exists",
      "path": "memory/working/social-tracker-*.md",
      "description": "sterling-social-tracker working memory file written to memory/working/"
    },
    {
      "id": "sterling-social-tracker-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/social-tracker-*.md",
      "min_bytes": 200,
      "description": "sterling-social-tracker working memory file is substantive (>200 bytes)"
    },
    {
      "id": "sterling-social-tracker-wm-content",
      "check": "file_contains",
      "path": "memory/working/social-tracker-*.md",
      "pattern": "(?i)(event|social|wine)",
      "description": "sterling-social-tracker working memory contains expected content"
    }
  ]
}