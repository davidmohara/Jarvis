{
  "name": "email-drafting",
  "type": "workflow",
  "assertions": [
    {
      "id": "email-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/email-drafting/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Email drafting workflow state.yaml shows status: complete"
    },
    {
      "id": "email-dr-001-exists",
      "check": "file_exists",
      "path": "memory/working/email-drafting-*.md",
      "description": "email-drafting output file was written"
    },
    {
      "id": "email-dr-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/email-drafting-*.md",
      "min_bytes": 200,
      "description": "email-drafting output is substantive (>200 bytes)"
    },
    {
      "id": "email-dr-003-content",
      "check": "file_contains",
      "path": "memory/working/email-drafting-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "email-drafting output contains expected content"
    }
  ]
}