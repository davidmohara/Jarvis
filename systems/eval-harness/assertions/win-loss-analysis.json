{
  "name": "win-loss-analysis",
  "type": "workflow",
  "assertions": [
    {
      "id": "winloss-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/win-loss-analysis/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Win-loss analysis workflow state.yaml shows status: complete"
    },
    {
      "id": "win_loss_ana-wm-written",
      "check": "file_exists",
      "path": "memory/working/win-loss-analysis-*.md",
      "description": "Win/loss analysis working memory file was written to memory/working/"
    },
    {
      "id": "win_loss_ana-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/win-loss-analysis-*.md",
      "min_bytes": 200,
      "description": "Win/loss analysis working memory file is substantive (>200 bytes)"
    },
    {
      "id": "win_loss_ana-wm-content",
      "check": "file_contains",
      "path": "memory/working/win-loss-analysis-*.md",
      "pattern": "(?i)(win|loss|lesson)",
      "description": "Win/loss analysis working memory contains expected content"
    }
  ]
}