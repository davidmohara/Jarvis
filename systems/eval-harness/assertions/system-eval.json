{
  "name": "system-eval",
  "type": "workflow",
  "assertions": [
    {
      "id": "system-eval-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/system-eval/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "system-eval state.yaml shows status: complete"
    },
    {
      "id": "system-eval-002-analysis-written",
      "check": "file_exists",
      "path": "systems/eval-harness/grading/analysis-*.md",
      "description": "Analysis report was written to grading/"
    },
    {
      "id": "system-eval-003-analysis-substantive",
      "check": "file_min_bytes",
      "path": "systems/eval-harness/grading/analysis-*.md",
      "min_bytes": 500,
      "description": "Analysis report is substantive (>500 bytes)"
    },
    {
      "id": "system-eval-004-dashboard-written",
      "check": "file_exists",
      "path": "systems/eval-harness/dashboard.html",
      "description": "Dashboard HTML file exists"
    },
    {
      "id": "system-eval-005-dashboard-substantive",
      "check": "file_min_bytes",
      "path": "systems/eval-harness/dashboard.html",
      "min_bytes": 1000,
      "description": "Dashboard HTML is substantive (>1000 bytes)"
    },
    {
      "id": "system-eval-006-grade-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/rigby-eval-grade-latest.json",
      "description": "Eval grade skill-run signal was written"
    },
    {
      "id": "system-eval-007-analyze-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/rigby-eval-analyze-latest.json",
      "description": "Eval analyze skill-run signal was written"
    },
    {
      "id": "system-eval-008-dashboard-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/rigby-eval-dashboard-latest.json",
      "description": "Eval dashboard skill-run signal was written"
    }
  ]
}
