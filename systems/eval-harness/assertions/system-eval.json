{
  "name": "system-eval",
  "type": "workflow",
  "assertions": [
    {
      "id": "system-eval-001-run-record-success",
      "check": "file_contains",
      "path": "systems/eval-harness/runs/eval-*.json",
      "pattern": "\"status\": \"success\"",
      "description": "Most recent eval run record reports status: success (replaces broken state.yaml check — state.yaml is overwritten to in-progress before assertions run)"
    },
    {
      "id": "system-eval-002-analysis-written",
      "check": "file_exists",
      "path": "systems/eval-harness/grading/analysis-*.md",
      "description": "Analysis report was written to grading/"
    },
    {
      "id": "system-eval-003-analysis-substantive",
      "check": "file_min_bytes",
      "path": "systems/eval-harness/grading/analysis-*.md",
      "min_bytes": 500,
      "description": "Analysis report is substantive (>500 bytes)"
    },
    {
      "id": "system-eval-004-dashboard-written",
      "check": "file_exists",
      "path": "systems/eval-harness/dashboard.html",
      "description": "Dashboard HTML file exists"
    },
    {
      "id": "system-eval-005-dashboard-substantive",
      "check": "file_min_bytes",
      "path": "systems/eval-harness/dashboard.html",
      "min_bytes": 1000,
      "description": "Dashboard HTML is substantive (>1000 bytes)"
    },
    {
      "id": "system-eval-006-grade-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/rigby-eval-grade-latest.json",
      "description": "Eval grade skill-run signal was written"
    },
    {
      "id": "system-eval-007-analyze-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/rigby-eval-analyze-latest.json",
      "description": "Eval analyze skill-run signal was written"
    },
    {
      "id": "system-eval-008-dashboard-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/rigby-eval-dashboard-latest.json",
      "description": "Eval dashboard skill-run signal was written"
    },
    {
      "id": "system-eval-009-analysis-contains-recommendations",
      "check": "file_contains",
      "path": "systems/eval-harness/grading/analysis-*.md",
      "pattern": "(?i)(recommend|finding|pattern|issue|fix)",
      "description": "Analysis report contains substantive recommendations (replaces broken working-memory check — system-eval does not produce a working memory file)"
    },
    {
      "id": "system-eval-010-guardrail-checkpoint-ran",
      "check": "guardrail_checkpoint_ran",
      "checkpoint_name": "pre-score-review",
      "description": "step-03b's guardrail checkpoint recorded a result (pass/flag/escalate) before step-04's composite scoring — read from the eval record's own guardrails array, not self-reported by the workflow"
    }
  ]
}