{
  "name": "rigby-package-create",
  "type": "skill",
  "assertions": [
    {
      "id": "rigby-package-create-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/rigby-package-create-latest.json",
      "description": "rigby-package-create skill-run signal file was written"
    },
    {
      "id": "rigby-package-create-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/rigby-package-create-latest.json",
      "field": "status",
      "value": "failure",
      "description": "rigby-package-create skill-run did not end in failure"
    },
    {
      "id": "rigby-pa-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/rigby-package-create-*.md",
      "min_bytes": 200,
      "description": "rigby-package-create output is substantive (>200 bytes)"
    },
    {
      "id": "rigby-pa-003-content",
      "check": "file_contains",
      "path": "memory/working/rigby-package-create-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "rigby-package-create output contains expected content"
    }
  ]
}