{
  "name": "knox-transcripts-teams",
  "type": "skill",
  "assertions": [
    {
      "id": "knox-transcripts-teams-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/knox-transcripts-teams-latest.json",
      "description": "knox-transcripts-teams skill-run signal file was written"
    },
    {
      "id": "knox-transcripts-teams-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/knox-transcripts-teams-latest.json",
      "field": "status",
      "value": "failure",
      "description": "knox-transcripts-teams skill-run did not end in failure"
    },
    {
      "id": "knox-tra-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/knox-transcripts-teams-*.md",
      "min_bytes": 200,
      "description": "knox-transcripts-teams output is substantive (>200 bytes)"
    },
    {
      "id": "knox-tra-003-content",
      "check": "file_contains",
      "path": "memory/working/knox-transcripts-teams-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "knox-transcripts-teams output contains expected content"
    }
  ]
}