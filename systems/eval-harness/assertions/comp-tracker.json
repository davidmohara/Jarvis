{
  "name": "comp-tracker",
  "type": "workflow",
  "assertions": [
    {
      "id": "comp-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/comp-tracker/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Comp tracker workflow state.yaml shows status: complete"
    },
    {
      "id": "comp-tra-001-exists",
      "check": "file_exists",
      "path": "memory/working/comp-tracker-*.md",
      "description": "comp-tracker output file was written"
    },
    {
      "id": "comp-tra-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/comp-tracker-*.md",
      "min_bytes": 200,
      "description": "comp-tracker output is substantive (>200 bytes)"
    },
    {
      "id": "comp-tra-003-content",
      "check": "file_contains",
      "path": "memory/working/comp-tracker-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "comp-tracker output contains expected content"
    }
  ]
}