{
  "name": "rigby-scheduled-setup",
  "type": "skill",
  "assertions": [
    {
      "id": "rigby-scheduled-setup-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/rigby-scheduled-setup-latest.json",
      "description": "rigby-scheduled-setup skill-run signal file was written"
    },
    {
      "id": "rigby-scheduled-setup-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/rigby-scheduled-setup-latest.json",
      "field": "status",
      "value": "failure",
      "description": "rigby-scheduled-setup skill-run did not end in failure"
    },
    {
      "id": "rigby-sc-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/rigby-scheduled-setup-*.md",
      "min_bytes": 200,
      "description": "rigby-scheduled-setup output is substantive (>200 bytes)"
    },
    {
      "id": "rigby-sc-003-content",
      "check": "file_contains",
      "path": "memory/working/rigby-scheduled-setup-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "rigby-scheduled-setup output contains expected content"
    }
  ]
}