{
  "name": "delegation-tracker",
  "type": "workflow",
  "assertions": [
    {
      "id": "deleg-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/delegation-tracker/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Delegation tracker workflow state.yaml shows status: complete"
    },
    {
      "id": "delegati-001-exists",
      "check": "file_exists",
      "path": "memory/working/delegation-tracker-*.md",
      "description": "delegation-tracker output file was written"
    },
    {
      "id": "delegati-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/delegation-tracker-*.md",
      "min_bytes": 200,
      "description": "delegation-tracker output is substantive (>200 bytes)"
    },
    {
      "id": "delegati-003-content",
      "check": "file_contains",
      "path": "memory/working/delegation-tracker-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "delegation-tracker output contains expected content"
    },
    {
      "id": "deleg-s2-tracker-exists",
      "check": "file_exists",
      "category": "content",
      "path": "delegations/tracker.md",
      "description": "Shep S2 (delegation sync fidelity): the delegation tracker exists after the run."
    },
    {
      "id": "deleg-s2-tracker-has-delegations",
      "check": "file_contains",
      "category": "content",
      "path": "delegations/tracker.md",
      "pattern": "(?i)delegated to|active delegations|status",
      "description": "Shep S2: the delegation tracker carries the delegation table structure (owner + status columns)."
    },
    {
      "id": "deleg-s2-omnifocus-mirror",
      "check": "file_exists",
      "category": "content",
      "path": "data/omnifocus-unified.json",
      "description": "Shep S2 (delegation sync fidelity): the OmniFocus mirror data file exists so tracker changes have a live counterpart to mirror into. Honest limit: presence, not zero-drift; drift detection needs the tracker-vs-OmniFocus diff A/B."
    }
  ]
}