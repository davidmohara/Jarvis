{
  "name": "evolution-training-sync",
  "type": "workflow",
  "assertions": [
    {
      "id": "evo-sync-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/evolution-training-sync/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Evolution training sync workflow state.yaml shows status: complete"
    },
    {
      "id": "evolutio-001-exists",
      "check": "file_exists",
      "path": "memory/working/evolution-training-sync-*.md",
      "description": "evolution-training-sync output file was written"
    },
    {
      "id": "evolutio-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/evolution-training-sync-*.md",
      "min_bytes": 200,
      "description": "evolution-training-sync output is substantive (>200 bytes)"
    },
    {
      "id": "evolutio-003-content",
      "check": "file_contains",
      "path": "memory/working/evolution-training-sync-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "evolution-training-sync output contains expected content"
    }
  ]
}