{
  "name": "account-strategy",
  "type": "workflow",
  "assertions": [
    {
      "id": "acct-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/account-strategy/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Account strategy workflow state.yaml shows status: complete"
    },
    {
      "id": "account_stra-wm-written",
      "check": "file_exists",
      "path": "memory/working/account-strategy-*.md",
      "description": "Account strategy working memory file was written to memory/working/"
    },
    {
      "id": "account_stra-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/account-strategy-*.md",
      "min_bytes": 200,
      "description": "Account strategy working memory file is substantive (>200 bytes)"
    },
    {
      "id": "account_stra-wm-content",
      "check": "file_contains",
      "path": "memory/working/account-strategy-*.md",
      "pattern": "(?i)(account|strategy|play)",
      "description": "Account strategy working memory contains expected content"
    }
  ]
}