{
  "name": "lead-review",
  "type": "workflow",
  "assertions": [
    {
      "id": "leadrev-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/lead-review/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Lead review workflow state.yaml shows status: complete"
    },
    {
      "id": "lead_review-wm-written",
      "check": "file_exists",
      "path": "memory/working/lead-review-*.md",
      "description": "Lead review working memory file was written to memory/working/"
    },
    {
      "id": "lead_review-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/lead-review-*.md",
      "min_bytes": 200,
      "description": "Lead review working memory file is substantive (>200 bytes)"
    },
    {
      "id": "lead_review-wm-content",
      "check": "file_contains",
      "path": "memory/working/lead-review-*.md",
      "pattern": "(?i)(lead|assign|handoff)",
      "description": "Lead review working memory contains expected content"
    }
  ]
}