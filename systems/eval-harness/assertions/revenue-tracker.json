{
  "name": "revenue-tracker",
  "type": "skill",
  "assertions": [
    {
      "id": "revenue-tracker-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/revenue-tracker-latest.json",
      "description": "revenue-tracker skill-run signal file was written"
    },
    {
      "id": "revenue-tracker-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/revenue-tracker-latest.json",
      "field": "status",
      "value": "failure",
      "description": "revenue-tracker skill-run did not end in failure"
    },
    {
      "id": "revenue-tracker-wm-written",
      "check": "file_exists",
      "path": "memory/working/revenue-tracker-*.md",
      "description": "revenue-tracker working memory file written to memory/working/"
    },
    {
      "id": "revenue-tracker-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/revenue-tracker-*.md",
      "min_bytes": 200,
      "description": "revenue-tracker working memory file is substantive (>200 bytes)"
    },
    {
      "id": "revenue-tracker-wm-content",
      "check": "file_contains",
      "path": "memory/working/revenue-tracker-*.md",
      "pattern": "(?i)(revenue|target|region)",
      "description": "revenue-tracker working memory contains expected content"
    }
  ]
}