{
  "name": "plaud-ingest",
  "type": "workflow",
  "assertions": [
    {
      "id": "plaud-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/plaud-ingest/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Plaud ingest workflow state.yaml shows status: complete"
    },
    {
      "id": "plaud_ingest-wm-written",
      "check": "file_exists",
      "path": "memory/working/plaud-ingest-*.md",
      "description": "Plaud ingest working memory file was written to memory/working/"
    },
    {
      "id": "plaud_ingest-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/plaud-ingest-*.md",
      "min_bytes": 200,
      "description": "Plaud ingest working memory file is substantive (>200 bytes)"
    },
    {
      "id": "plaud_ingest-wm-content",
      "check": "file_contains",
      "path": "memory/working/plaud-ingest-*.md",
      "pattern": "(?i)(ingest|transcript|vault)",
      "description": "Plaud ingest working memory contains expected content"
    }
  ]
}