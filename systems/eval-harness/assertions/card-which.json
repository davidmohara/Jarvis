{
  "name": "card-which",
  "type": "workflow",
  "assertions": [
    {
      "id": "cardwhich-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/card-which/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Card-which workflow state.yaml shows status: complete"
    },
    {
      "id": "card-whi-001-exists",
      "check": "file_exists",
      "path": "memory/working/card-which-*.md",
      "description": "card-which output file was written"
    },
    {
      "id": "card-whi-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/card-which-*.md",
      "min_bytes": 200,
      "description": "card-which output is substantive (>200 bytes)"
    },
    {
      "id": "card-whi-003-content",
      "check": "file_contains",
      "path": "memory/working/card-which-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "card-which output contains expected content"
    }
  ]
}