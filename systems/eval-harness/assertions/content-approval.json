{
  "name": "content-approval",
  "type": "workflow",
  "assertions": [
    {
      "id": "coap-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/content-approval/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "content-approval workflow state.yaml shows status: complete"
    },
    {
      "id": "coap-002-wm-written",
      "check": "file_exists",
      "path": "memory/working/content-approval-*.md",
      "description": "content-approval working memory file was written to memory/working/"
    },
    {
      "id": "coap-003-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/content-approval-*.md",
      "min_bytes": 200,
      "description": "content-approval working memory file is substantive (>200 bytes)"
    },
    {
      "id": "coap-004-wm-content",
      "check": "file_contains",
      "path": "memory/working/content-approval-*.md",
      "pattern": "(?i)(approv|ghost|publish)",
      "description": "content-approval working memory contains expected content"
    }
  ]
}
