{
  "name": "weekly-knowledge-review",
  "type": "workflow",
  "assertions": [
    {
      "id": "wkr-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/weekly-knowledge-review/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Weekly knowledge review workflow state.yaml shows status: complete"
    },
    {
      "id": "weekly-k-001-exists",
      "check": "file_exists",
      "path": "memory/working/weekly-knowledge-review-*.md",
      "description": "weekly-knowledge-review output file was written"
    },
    {
      "id": "weekly-k-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/weekly-knowledge-review-*.md",
      "min_bytes": 200,
      "description": "weekly-knowledge-review output is substantive (>200 bytes)"
    },
    {
      "id": "weekly-k-003-content",
      "check": "file_contains",
      "path": "memory/working/weekly-knowledge-review-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "weekly-knowledge-review output contains expected content"
    }
  ]
}