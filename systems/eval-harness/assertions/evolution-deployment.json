{
  "name": "evolution-deployment",
  "type": "workflow",
  "assertions": [
    {
      "id": "evo-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/evolution-deployment/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Evolution deployment workflow state.yaml shows status: complete"
    },
    {
      "id": "evo-002-snapshot-exists",
      "check": "file_exists",
      "path": "evolutions/snapshots/*.json",
      "description": "Evolution snapshot manifest was created"
    },
    {
      "id": "evo-003-history-updated",
      "check": "file_exists",
      "path": "evolutions/history.jsonl",
      "description": "Evolution history log exists"
    },
    {
      "id": "evo-004-history-substantive",
      "check": "file_min_bytes",
      "path": "evolutions/history.jsonl",
      "min_bytes": 50,
      "description": "Evolution history log has at least one entry"
    },
    {
      "id": "evo-005-no-conflict-errors",
      "check": "yaml_field_equals",
      "path": "workflows/evolution-deployment/state.yaml",
      "field": "conflicts_found",
      "value": false,
      "description": "No unresolved conflicts reported in state.yaml"
    },
    {
      "id": "evolutio-003-content",
      "check": "file_contains",
      "path": "memory/working/evolution-deployment-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "evolution-deployment output contains expected content"
    }
  ]
}