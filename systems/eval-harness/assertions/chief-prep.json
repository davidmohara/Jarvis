{
  "name": "chief-prep",
  "type": "skill",
  "assertions": [
    {
      "id": "chief-prep-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/chief-prep-latest.json",
      "description": "chief-prep skill-run signal file was written"
    },
    {
      "id": "chief-prep-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/chief-prep-latest.json",
      "field": "status",
      "value": "failure",
      "description": "chief-prep skill-run did not end in failure"
    },
    {
      "id": "chief-pr-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/chief-prep-*.md",
      "min_bytes": 200,
      "description": "chief-prep output is substantive (>200 bytes)"
    },
    {
      "id": "chief-pr-003-content",
      "check": "file_contains",
      "path": "memory/working/chief-prep-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "chief-prep output contains expected content"
    }
  ]
}