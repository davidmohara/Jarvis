{
  "name": "podcast-prep",
  "type": "workflow",
  "assertions": [
    {
      "id": "podcast-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/podcast-prep/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Podcast prep workflow state.yaml shows status: complete"
    },
    {
      "id": "podcast--001-exists",
      "check": "file_exists",
      "path": "memory/working/podcast-prep-*.md",
      "description": "podcast-prep output file was written"
    },
    {
      "id": "podcast--002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/podcast-prep-*.md",
      "min_bytes": 200,
      "description": "podcast-prep output is substantive (>200 bytes)"
    },
    {
      "id": "podcast--003-content",
      "check": "file_contains",
      "path": "memory/working/podcast-prep-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "podcast-prep output contains expected content"
    }
  ]
}