{
  "name": "rigby-capability-status",
  "type": "skill",
  "assertions": [
    {
      "id": "rigby-capability-status-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/rigby-capability-status-latest.json",
      "description": "rigby-capability-status skill-run signal file was written"
    },
    {
      "id": "rigby-capability-status-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/rigby-capability-status-latest.json",
      "field": "status",
      "value": "failure",
      "description": "rigby-capability-status skill-run did not end in failure"
    },
    {
      "id": "rigby-ca-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/rigby-capability-status-*.md",
      "min_bytes": 200,
      "description": "rigby-capability-status output is substantive (>200 bytes)"
    },
    {
      "id": "rigby-ca-003-content",
      "check": "file_contains",
      "path": "memory/working/rigby-capability-status-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "rigby-capability-status output contains expected content"
    }
  ]
}