{
  "name": "chase-card-optimizer",
  "type": "skill",
  "assertions": [
    {
      "id": "chase-card-optimizer-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/chase-card-optimizer-latest.json",
      "description": "chase-card-optimizer skill-run signal file was written"
    },
    {
      "id": "chase-card-optimizer-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/chase-card-optimizer-latest.json",
      "field": "status",
      "value": "failure",
      "description": "chase-card-optimizer skill-run did not end in failure"
    },
    {
      "id": "chase-ca-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/chase-card-optimizer-*.md",
      "min_bytes": 200,
      "description": "chase-card-optimizer output is substantive (>200 bytes)"
    },
    {
      "id": "chase-ca-003-content",
      "check": "file_contains",
      "path": "memory/working/chase-card-optimizer-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "chase-card-optimizer output contains expected content"
    }
  ]
}