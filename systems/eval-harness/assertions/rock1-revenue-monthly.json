{
  "name": "rock1-revenue-monthly",
  "type": "workflow",
  "assertions": [
    {
      "id": "rock1-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/rock1-revenue-monthly/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Rock 1 revenue monthly workflow state.yaml shows status: complete"
    },
    {
      "id": "rock1-re-001-exists",
      "check": "file_exists",
      "path": "memory/working/rock1-revenue-monthly-*.md",
      "description": "rock1-revenue-monthly output file was written"
    },
    {
      "id": "rock1-re-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/rock1-revenue-monthly-*.md",
      "min_bytes": 200,
      "description": "rock1-revenue-monthly output is substantive (>200 bytes)"
    },
    {
      "id": "rock1-re-003-content",
      "check": "file_contains",
      "path": "memory/working/rock1-revenue-monthly-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "rock1-revenue-monthly output contains expected content"
    }
  ]
}