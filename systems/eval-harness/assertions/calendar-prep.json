{
  "name": "calendar-prep",
  "type": "workflow",
  "assertions": [
    {
      "id": "calprep-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/calendar-prep/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Calendar prep workflow state.yaml shows status: complete"
    },
    {
      "id": "calendar-001-exists",
      "check": "file_exists",
      "path": "memory/working/calendar-prep-*.md",
      "description": "calendar-prep output file was written"
    },
    {
      "id": "calendar-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/calendar-prep-*.md",
      "min_bytes": 200,
      "description": "calendar-prep output is substantive (>200 bytes)"
    },
    {
      "id": "calendar-003-content",
      "check": "file_contains",
      "path": "memory/working/calendar-prep-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "calendar-prep output contains expected content"
    }
  ]
}