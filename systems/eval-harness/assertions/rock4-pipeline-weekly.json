{
  "name": "rock4-pipeline-weekly",
  "type": "workflow",
  "assertions": [
    {
      "id": "rock4-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/rock4-pipeline-weekly/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Rock 4 pipeline weekly workflow state.yaml shows status: complete"
    },
    {
      "id": "rock4-pi-001-exists",
      "check": "file_exists",
      "path": "memory/working/rock4-pipeline-weekly-*.md",
      "description": "rock4-pipeline-weekly output file was written"
    },
    {
      "id": "rock4-pi-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/rock4-pipeline-weekly-*.md",
      "min_bytes": 200,
      "description": "rock4-pipeline-weekly output is substantive (>200 bytes)"
    },
    {
      "id": "rock4-pi-003-content",
      "check": "file_contains",
      "path": "memory/working/rock4-pipeline-weekly-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "rock4-pipeline-weekly output contains expected content"
    }
  ]
}