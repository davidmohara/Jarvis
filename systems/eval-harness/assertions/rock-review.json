{
  "name": "rock-review",
  "type": "workflow",
  "assertions": [
    {
      "id": "rockrev-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/rock-review/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Rock review workflow state.yaml shows status: complete"
    },
    {
      "id": "rock_review-wm-written",
      "check": "file_exists",
      "path": "memory/working/rock-review-*.md",
      "description": "Rock review working memory file was written to memory/working/"
    },
    {
      "id": "rock_review-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/rock-review-*.md",
      "min_bytes": 200,
      "description": "Rock review working memory file is substantive (>200 bytes)"
    },
    {
      "id": "rock_review-wm-content",
      "check": "file_contains",
      "path": "memory/working/rock-review-*.md",
      "pattern": "(?i)(rock|quarter|progress)",
      "description": "Rock review working memory contains expected content"
    }
  ]
}