{
  "name": "error-improvement",
  "type": "workflow",
  "assertions": [
    {
      "id": "error-improvement-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/error-improvement/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Workflow state.yaml shows status: complete"
    },
    {
      "id": "error-improvement-eval-record-written",
      "check": "file_exists_pattern",
      "path": "systems/eval-harness/runs/eval-*.json",
      "match_field": "name",
      "match_value": "error-improvement",
      "description": "Eval record was written for this workflow run"
    },
    {
      "id": "error-improvement-episodic-memory-written",
      "check": "file_exists_pattern",
      "path": "memory/episodic/decisions/*error-improvement*.md",
      "description": "Episodic memory entry was written for the improvement cycle"
    },
    {
      "id": "error-improvement-pending-changes-updated",
      "check": "file_contains",
      "path": "evolutions/.pending-changes.json",
      "contains": "error-improvement",
      "description": "error-improvement work item logged to pending-changes"
    },
    {
      "id": "error-improvement-no-proposed-entries-remain",
      "check": "directory_file_count_max",
      "path": "systems/error-tracking/entries",
      "pattern": "err-*.json",
      "field_filter": {"fix_status": "proposed"},
      "max_count": 15,
      "description": "Proposed entries not growing unboundedly (soft ceiling — routing-gate entries expected)"
    }
  ]
}
