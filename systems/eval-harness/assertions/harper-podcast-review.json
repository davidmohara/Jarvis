{
  "name": "harper-podcast-review",
  "type": "skill",
  "assertions": [
    {
      "id": "harper-podcast-review-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/harper-podcast-review-latest.json",
      "description": "harper-podcast-review skill-run signal file was written"
    },
    {
      "id": "harper-podcast-review-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/harper-podcast-review-latest.json",
      "field": "status",
      "value": "failure",
      "description": "harper-podcast-review skill-run did not end in failure"
    },
    {
      "id": "harper-p-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/harper-podcast-review-*.md",
      "min_bytes": 200,
      "description": "harper-podcast-review output is substantive (>200 bytes)"
    },
    {
      "id": "harper-p-003-content",
      "check": "file_contains",
      "path": "memory/working/harper-podcast-review-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "harper-podcast-review output contains expected content"
    }
  ]
}