{
  "name": "rigby-connector-verify",
  "type": "skill",
  "assertions": [
    {
      "id": "rigby-connector-verify-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/rigby-connector-verify-latest.json",
      "description": "rigby-connector-verify skill-run signal file was written"
    },
    {
      "id": "rigby-connector-verify-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/rigby-connector-verify-latest.json",
      "field": "status",
      "value": "failure",
      "description": "rigby-connector-verify skill-run did not end in failure"
    },
    {
      "id": "rigby-co-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/rigby-connector-verify-*.md",
      "min_bytes": 200,
      "description": "rigby-connector-verify output is substantive (>200 bytes)"
    },
    {
      "id": "rigby-co-003-content",
      "check": "file_contains",
      "path": "memory/working/rigby-connector-verify-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "rigby-connector-verify output contains expected content"
    }
  ]
}