{
  "name": "knox-search",
  "type": "skill",
  "assertions": [
    {
      "id": "knox-search-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/knox-search-latest.json",
      "description": "knox-search skill-run signal file was written"
    },
    {
      "id": "knox-search-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/knox-search-latest.json",
      "field": "status",
      "value": "failure",
      "description": "knox-search skill-run did not end in failure"
    },
    {
      "id": "knox-sea-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/knox-search-*.md",
      "min_bytes": 200,
      "description": "knox-search output is substantive (>200 bytes)"
    },
    {
      "id": "knox-sea-003-content",
      "check": "file_contains",
      "path": "memory/working/knox-search-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "knox-search output contains expected content"
    }
  ]
}