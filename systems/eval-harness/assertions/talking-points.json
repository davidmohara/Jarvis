{
  "name": "talking-points",
  "type": "workflow",
  "assertions": [
    {
      "id": "tp-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/talking-points/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Talking points workflow state.yaml shows status: complete"
    },
    {
      "id": "talking--001-exists",
      "check": "file_exists",
      "path": "memory/working/talking-points-*.md",
      "description": "talking-points output file was written"
    },
    {
      "id": "talking--002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/talking-points-*.md",
      "min_bytes": 200,
      "description": "talking-points output is substantive (>200 bytes)"
    },
    {
      "id": "talking--003-content",
      "check": "file_contains",
      "path": "memory/working/talking-points-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "talking-points output contains expected content"
    }
  ]
}