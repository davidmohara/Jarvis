{
  "name": "chase-win-loss",
  "type": "skill",
  "assertions": [
    {
      "id": "chase-win-loss-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/chase-win-loss-latest.json",
      "description": "chase-win-loss skill-run signal file was written"
    },
    {
      "id": "chase-win-loss-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/chase-win-loss-latest.json",
      "field": "status",
      "value": "failure",
      "description": "chase-win-loss skill-run did not end in failure"
    },
    {
      "id": "chase-win-loss-wm-written",
      "check": "file_exists",
      "path": "memory/working/win-loss-analysis-*.md",
      "description": "chase-win-loss working memory file written to memory/working/"
    },
    {
      "id": "chase-win-loss-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/win-loss-analysis-*.md",
      "min_bytes": 200,
      "description": "chase-win-loss working memory file is substantive (>200 bytes)"
    },
    {
      "id": "chase-win-loss-wm-content",
      "check": "file_contains",
      "path": "memory/working/win-loss-analysis-*.md",
      "pattern": "(?i)(win|loss|lesson)",
      "description": "chase-win-loss working memory contains expected content"
    }
  ]
}