{
  "name": "follow-up-nudges",
  "type": "workflow",
  "assertions": [
    {
      "id": "nudge-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/follow-up-nudges/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Follow-up nudges workflow state.yaml shows status: complete"
    },
    {
      "id": "follow-u-001-exists",
      "check": "file_exists",
      "path": "memory/working/follow-up-nudges-*.md",
      "description": "follow-up-nudges output file was written"
    },
    {
      "id": "follow-u-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/follow-up-nudges-*.md",
      "min_bytes": 200,
      "description": "follow-up-nudges output is substantive (>200 bytes)"
    },
    {
      "id": "follow-u-003-content",
      "check": "file_contains",
      "path": "memory/working/follow-up-nudges-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "follow-up-nudges output contains expected content"
    }
  ]
}