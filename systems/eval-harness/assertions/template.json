{
  "name": "workflow-or-skill-name",
  "type": "workflow",
  "assertions": [
    {
      "id": "assert-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/{name}/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Workflow state.yaml shows status: complete"
    },
    {
      "id": "assert-002-output-written",
      "check": "file_exists",
      "path": "memory/working/{output-file}.md",
      "description": "Expected output file was written"
    },
    {
      "id": "assert-003-output-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/{output-file}.md",
      "min_bytes": 200,
      "description": "Output file is substantive (>200 bytes)"
    }
  ]
}
