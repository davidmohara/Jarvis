{
  "name": "inbox-processing",
  "type": "workflow",
  "assertions": [
    {
      "id": "inbox-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/inbox-processing/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Inbox processing workflow state.yaml shows status: complete"
    },
    {
      "id": "inbox-pr-001-exists",
      "check": "file_exists",
      "path": "memory/working/inbox-processing-*.md",
      "description": "inbox-processing output file was written"
    },
    {
      "id": "inbox-pr-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/inbox-processing-*.md",
      "min_bytes": 200,
      "description": "inbox-processing output is substantive (>200 bytes)"
    },
    {
      "id": "inbox-pr-003-content",
      "check": "file_contains",
      "path": "memory/working/inbox-processing-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "inbox-processing output contains expected content"
    }
  ]
}