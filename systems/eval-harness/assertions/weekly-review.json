{
  "name": "weekly-review",
  "type": "workflow",
  "assertions": [
    {
      "id": "weekly-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/weekly-review/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Weekly review workflow state.yaml shows status: complete"
    },
    {
      "id": "weekly-002-all-steps-complete",
      "check": "step_count_gte",
      "min_steps": 6,
      "description": "All 6 weekly review steps completed"
    },
    {
      "id": "weekly-003-output-written",
      "check": "file_exists",
      "path": "memory/working/weekly-review-*.md",
      "description": "Weekly review output file was written to memory/working/"
    },
    {
      "id": "weekly-004-output-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/weekly-review-*.md",
      "min_bytes": 1000,
      "description": "Weekly review output is substantive (>1000 bytes)"
    },
    {
      "id": "weekly-005-wins-section",
      "check": "file_contains",
      "path": "memory/working/weekly-review-*.md",
      "pattern": "(?i)(wins|successes|accomplishments)",
      "description": "Weekly review contains wins/accomplishments section"
    },
    {
      "id": "weekly-006-rocks-section",
      "check": "file_contains",
      "path": "memory/working/weekly-review-*.md",
      "pattern": "(?i)(rocks|quarterly|q[1-4])",
      "description": "Weekly review contains rocks/quarterly goals section"
    },
    {
      "id": "weekly-007-delegations-section",
      "check": "file_contains",
      "path": "memory/working/weekly-review-*.md",
      "pattern": "(?i)(delegation|follow.?up)",
      "description": "Weekly review contains delegations/follow-up section"
    }
  ]
}
