{
  "name": "rigby-eval-grade",
  "type": "skill",
  "assertions": [
    {
      "id": "eval-grade-001-records-graded",
      "check": "file_contains",
      "path": "systems/eval-harness/runs/eval-*.json",
      "pattern": "\"grade\":\\s*\"[A-F]\"",
      "description": "At least one eval record has a grade assigned"
    },
    {
      "id": "rigby-ev-001-exists",
      "check": "file_exists",
      "path": "memory/working/rigby-eval-grade-*.md",
      "description": "rigby-eval-grade output file was written"
    },
    {
      "id": "rigby-ev-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/rigby-eval-grade-*.md",
      "min_bytes": 200,
      "description": "rigby-eval-grade output is substantive (>200 bytes)"
    }
  ]
}