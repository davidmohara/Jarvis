{
  "name": "leadership-prep",
  "type": "workflow",
  "assertions": [
    {
      "id": "leaderprep-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/leadership-prep/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Leadership prep workflow state.yaml shows status: complete"
    },
    {
      "id": "leadership_p-wm-written",
      "check": "file_exists",
      "path": "memory/working/leadership-prep-*.md",
      "description": "Leadership prep working memory file was written to memory/working/"
    },
    {
      "id": "leadership_p-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/leadership-prep-*.md",
      "min_bytes": 200,
      "description": "Leadership prep working memory file is substantive (>200 bytes)"
    },
    {
      "id": "leadership_p-wm-content",
      "check": "file_contains",
      "path": "memory/working/leadership-prep-*.md",
      "pattern": "(?i)(prep|event|talk)",
      "description": "Leadership prep working memory contains expected content"
    }
  ]
}