{
  "name": "lead-log",
  "type": "workflow",
  "assertions": [
    {
      "id": "leadlog-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/lead-log/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Lead log workflow state.yaml shows status: complete"
    },
    {
      "id": "lead-log-001-exists",
      "check": "file_exists",
      "path": "memory/working/lead-log-*.md",
      "description": "lead-log output file was written"
    },
    {
      "id": "lead-log-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/lead-log-*.md",
      "min_bytes": 200,
      "description": "lead-log output is substantive (>200 bytes)"
    },
    {
      "id": "lead-log-003-content",
      "check": "file_contains",
      "path": "memory/working/lead-log-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "lead-log output contains expected content"
    }
  ]
}