{
  "name": "quinn-alignment",
  "type": "skill",
  "assertions": [
    {
      "id": "quinn-alignment-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/quinn-alignment-latest.json",
      "description": "quinn-alignment skill-run signal file was written"
    },
    {
      "id": "quinn-alignment-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/quinn-alignment-latest.json",
      "field": "status",
      "value": "failure",
      "description": "quinn-alignment skill-run did not end in failure"
    },
    {
      "id": "quinn-alignment-wm-written",
      "check": "file_exists",
      "path": "memory/working/goal-alignment-*.md",
      "description": "quinn-alignment working memory file written to memory/working/"
    },
    {
      "id": "quinn-alignment-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/goal-alignment-*.md",
      "min_bytes": 200,
      "description": "quinn-alignment working memory file is substantive (>200 bytes)"
    },
    {
      "id": "quinn-alignment-wm-content",
      "check": "file_contains",
      "path": "memory/working/goal-alignment-*.md",
      "pattern": "(?i)(goal|drift|align)",
      "description": "quinn-alignment working memory contains expected content"
    }
  ]
}