{
  "name": "teams-transcripts",
  "type": "skill",
  "assertions": [
    {
      "id": "teams-transcripts-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/teams-transcripts-latest.json",
      "description": "teams-transcripts skill-run signal file was written"
    },
    {
      "id": "teams-transcripts-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/teams-transcripts-latest.json",
      "field": "status",
      "value": "failure",
      "description": "teams-transcripts skill-run did not end in failure"
    },
    {
      "id": "teams-tr-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/teams-transcripts-*.md",
      "min_bytes": 200,
      "description": "teams-transcripts output is substantive (>200 bytes)"
    },
    {
      "id": "teams-tr-003-content",
      "check": "file_contains",
      "path": "memory/working/teams-transcripts-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "teams-transcripts output contains expected content"
    }
  ]
}