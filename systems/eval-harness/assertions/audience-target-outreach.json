{
  "name": "audience-target-outreach",
  "type": "workflow",
  "assertions": [
    {
      "id": "auto-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/audience-target-outreach/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "audience-target-outreach workflow state.yaml shows status: complete"
    },
    {
      "id": "auto-002-wm-written",
      "check": "file_exists",
      "path": "memory/working/audience-target-outreach-*.md",
      "description": "audience-target-outreach working memory file was written to memory/working/"
    },
    {
      "id": "auto-003-wm-size",
      "check": "file_min_bytes",
      "path": "memory/working/audience-target-outreach-*.md",
      "min_bytes": 200,
      "description": "audience-target-outreach working memory file is substantive (>200 bytes)"
    },
    {
      "id": "auto-004-wm-content",
      "check": "file_contains",
      "path": "memory/working/audience-target-outreach-*.md",
      "pattern": "(?i)(target|outreach|campaign)",
      "description": "audience-target-outreach working memory contains expected content"
    }
  ]
}
