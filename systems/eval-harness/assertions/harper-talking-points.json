{
  "name": "harper-talking-points",
  "type": "skill",
  "assertions": [
    {
      "id": "harper-talking-points-signal-written",
      "check": "file_exists",
      "path": "systems/eval-harness/skill-runs/harper-talking-points-latest.json",
      "description": "harper-talking-points skill-run signal file was written"
    },
    {
      "id": "harper-talking-points-signal-status",
      "check": "json_field_not_equals",
      "path": "systems/eval-harness/skill-runs/harper-talking-points-latest.json",
      "field": "status",
      "value": "failure",
      "description": "harper-talking-points skill-run did not end in failure"
    },
    {
      "id": "harper-t-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/harper-talking-points-*.md",
      "min_bytes": 200,
      "description": "harper-talking-points output is substantive (>200 bytes)"
    },
    {
      "id": "harper-t-003-content",
      "check": "file_contains",
      "path": "memory/working/harper-talking-points-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "harper-talking-points output contains expected content"
    }
  ]
}