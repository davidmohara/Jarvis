{
  "name": "card-walkthrough",
  "type": "workflow",
  "assertions": [
    {
      "id": "cardwalk-001-state-complete",
      "check": "yaml_field_equals",
      "path": "workflows/card-walkthrough/state.yaml",
      "field": "status",
      "value": "complete",
      "description": "Card walkthrough workflow state.yaml shows status: complete"
    },
    {
      "id": "card-wal-001-exists",
      "check": "file_exists",
      "path": "memory/working/card-walkthrough-*.md",
      "description": "card-walkthrough output file was written"
    },
    {
      "id": "card-wal-002-substantive",
      "check": "file_min_bytes",
      "path": "memory/working/card-walkthrough-*.md",
      "min_bytes": 200,
      "description": "card-walkthrough output is substantive (>200 bytes)"
    },
    {
      "id": "card-wal-003-content",
      "check": "file_contains",
      "path": "memory/working/card-walkthrough-*.md",
      "pattern": "(?i)(complete|done|finished|output|result)",
      "description": "card-walkthrough output contains expected content"
    }
  ]
}