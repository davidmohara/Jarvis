{
  "agent": "master",
  "permissions": {
    "allow": [
      "Bash(rm .git/index.lock)",
      "Bash(git *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(ls*)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(rm *)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(stat *)",
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(osascript *)",
      "Bash(open *)",
      "Bash(say *)",
      "Bash(curl *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(brew *)",
      "Bash(which *)",
      "Bash(gh *)",
      "Bash(cat <<*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "mcp__obsidian-mcp-tools__*",
      "mcp__clay__*",
      "mcp__comet-bridge__*",
      "mcp__playwright__*",
      "mcp__sequential-thinking__*",
      "mcp__whoop__*",
      "mcp__claude_ai_Microsoft_365__*",
      "mcp__claude_ai_Clay__*",
      "mcp__claude_ai_Context7__*",
      "mcp__Control_your_Mac__osascript"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf /*)",
      "Bash(rm -fr /*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash '.claude/status-line.sh'"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '.claude/hooks/session-start.py'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '.claude/hooks/pre-tool-use.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '.claude/hooks/post-tool-use.py'"
          },
          {
            "type": "command",
            "command": "python3 '.claude/hooks/workflow-start.py'",
            "if": "Write(workflows/*/state.yaml)"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '.claude/hooks/eval-tool-failure.py'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '.claude/hooks/eval-agent-start.py'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '.claude/hooks/eval-agent-stop.py'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '.claude/hooks/eval-session-end.py'"
          }
        ]
      }
    ]
  }
}
