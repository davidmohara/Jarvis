#!/usr/bin/env python3
"""
IES authorized git execution path (the git-gate wrapper).

Mechanically enforces the rules that skills/git/SKILL.md states as prose:
  - one git operation per call (args run via subprocess list, never a shell)
  - `git status` is refused (lock-file hazard; lock-free alternatives offered)
  - destructive operations (force push, reset --hard, clean -f) require the
    --allow-destructive flag, and force push to main is refused outright
  - `commit` lints Conventional Commits before running
  - `commit` refuses when gated directories changed unless --ack-gated is set
  - `add`/`commit` scan diffs for credential-shaped content before running
  - every invocation is appended to an untracked audit spool (.git/ies/git-ops.jsonl),
    which the next `add` folds into the tracked systems/eval-harness/git-ops.jsonl
    (so the tracked log is never dirty by construction and never blocks rebase/autostash)

Invoked directly (python3 skills/git/scripts/ies-git <git args>) or
transparently, by .claude/hooks/git-gate.py rewriting raw `git <write-verb>`
Bash commands to route through here (see err-20261008T203600-9T2IVR for why
agents keep reaching for raw git).

Flags consumed by the wrapper itself (not passed to git):
  --ack-gated          acknowledge the gated-directory change list (commit)
  --ack-root-files     acknowledge non-canonical root-level staged files (commit)
  --allow-destructive  acknowledge a destructive-op refusal (never for
                       force push to main, which is refused unconditionally)

Non-git verbs implemented by the wrapper itself:
  session-commit [--dry-run] [summary...]
      Class A fast lane: pre-flight pattern blocker + deterministic path
      classifier (commit_classifier.py) + one `add -A` + one commit with a
      standard message. Refuses (non-zero) on forbidden artifacts, media
      deletions, secrets, or any non-Class-A path in the changeset.
  classify <path>...
      Print the risk class (A/B/other) of each repo-relative path.
"""

import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import commit_classifier as cc

IES_ROOT = Path(__file__).resolve().parents[3]
AUDIT_LOG = IES_ROOT / "systems" / "eval-harness" / "git-ops.jsonl"
# Live audit lines append to an untracked spool inside .git/ (invisible to
# git, immune to rebase/autostash, never dirty) and are folded into the
# tracked AUDIT_LOG only when an `add` is already staging, so the tracked
# file is never dirty by construction (2026-10-10: the always-dirty tracked
# log broke `git pull --rebase --autostash`).
AUDIT_SPOOL = IES_ROOT / ".git" / "ies" / "git-ops.jsonl"
ALLOWLIST_PATH = IES_ROOT / "skills" / "git" / "scripts" / "secret-allowlist.txt"

GATED_DIRS = ("workflows/", "skills/", "agents/", "systems/", ".claude/skills/")

# Canonical root-level entries (mirrors shutdown-cleanup's root check). A staged
# root-level file outside this set is a placement question and requires the
# conscious --ack-root-files flag; Office lock files (.~lock.*#) are refused
# outright (err-20261008T225136-RWH7B6: a live OneDrive-synced lock file was
# blanket-added and committed).
CANONICAL_ROOT = {
    "CLAUDE.md", "SETUP.md", "SYSTEM.md", "CHANGELOG.md", ".gitignore",
    "evolution.manifest.json", "improving.manifest.json",
    "accounts", "agents", "archive", "briefs", "config", "contacts",
    "context", "contributions", "data", "decisions", "delegations",
    "evolutions", "hooks", "identity", "logs", "meetings", "memory",
    "people", "podcast", "presentations", "projects", "proposals",
    "reference", "reports", "reviews", "scripts", "skills", "specs",
    "systems", "tasks", "Talks", "training", "workflows", "Remarkable",
    "YPO", "content",
}

# Same policy as the destructive blocklist in .claude/hooks/pre-tool-use.sh,
# enforced here because wrapper invocations do not match that script's
# ^git-anchored patterns.
DESTRUCTIVE_SUBCOMMANDS = ("reset", "clean")
PUSH_FORCE_FLAGS = ("--force", "-f", "--force-with-lease")

COMMIT_LINT = re.compile(
    r"^(feat|fix|chore|docs|refactor|perf|test|revert)"  # type
    r"(\([a-z0-9][a-z0-9-]*\))?"                          # optional scope
    r"(!)?"                                               # optional breaking marker
    r": "                                                 # separator
    r"[a-z][^\n]*$"                                       # lowercase imperative description
)

# Literal-value patterns: known key shapes and formats. High confidence by
# construction — these are what real leaked secrets look like.
SECRET_VALUE_PATTERNS = [
    re.compile(r"AKIA[0-9A-Z]{16}"),
    re.compile(r"sk-[A-Za-z0-9_-]{20,}"),
    re.compile(r"ghp_[A-Za-z0-9]{30,}"),
    re.compile(r"github_pat_[A-Za-z0-9_]{30,}"),
    re.compile(r"xox[baprs]-[A-Za-z0-9-]{10,}"),
    re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |PGP |DSA )?PRIVATE KEY-----"),
]

# Assignment patterns: a secret/token/password/api_key name with a value that
# looks like a literal, not an identifier. The value must be at least 12/16
# chars AND contain a digit — bare identifiers (access_token, save_token)
# carry no entropy signal and are the code that handles secrets, not a leak.
SECRET_PATTERNS = SECRET_VALUE_PATTERNS + [
    re.compile(r"(?i)api[_-]?key['\"]?\s*[:=]\s*['\"]?(?=[A-Za-z0-9_\-]{16,})(?=[A-Za-z0-9_\-]*[0-9])[A-Za-z0-9_\-]+"),
    re.compile(r"(?i)(?:secret|token|password)['\"]?\s*[:=]\s*['\"]?(?=[A-Za-z0-9_\-]{12,})(?=[A-Za-z0-9_\-]*[0-9])[A-Za-z0-9_\-]+"),
]

STATUS_REFUSAL = """refused: `git status` writes .git/index.lock as part of its index refresh,
which orphans on FUSE mounts and blocks all git operations until host-side cleanup
(see skills/git/SKILL.md, Atomic Command Rule). Lock-free alternatives:

  git diff --name-only HEAD          # all changes vs HEAD
  git diff --name-only               # unstaged changes
  git diff --staged --name-only      # staged changes
  git ls-files --modified --others --exclude-standard
"""

USAGE = "usage: python3 skills/git/scripts/ies-git [--ack-gated] [--allow-destructive] <git args>\n" \
        "       python3 skills/git/scripts/ies-git session-commit [--dry-run] [summary words...]\n" \
        "       python3 skills/git/scripts/ies-git classify <path> [<path>...]"


def session_commit(argv, ack_gated, allow_destructive):
    """Class A fast lane (err-20261013T231457-A7IQVJ): one stage + one commit
    of routine session churn, gated by the deterministic path classifier and
    the pre-flight pattern blocker. No --ack-gated ceremony (the classifier
    structurally excludes gated paths), no Ralph (pre-flight replaces
    post-hoc verification for Class A), one commit per pass (post-commit
    harness churn waits for the next session)."""
    dry_run = "--dry-run" in argv
    words = [a for a in argv if a != "--dry-run"]
    summary = " ".join(words).strip() or "routine class A churn"
    message = f"chore: session commit - {summary}"
    if not COMMIT_LINT.match(message):
        refuse("session-commit", argv, 1,
               f"refused: summary produced a non-conforming message: {message[:100]}\n"
               "Keep the summary lowercase and free of leading punctuation.",
               reason="session-commit-lint")

    harvest_audit()

    # Candidate set: everything `git add -A` would stage (tracked changes vs
    # HEAD, including deletions, plus untracked files).
    ns = git(["diff", "--name-status", "HEAD"], capture=True)
    status_paths = []
    for line in (ns.stdout or "").splitlines():
        if not line.strip():
            continue
        parts = line.split("\t")
        status_paths.append((parts[0][0], parts[-1]))
    untracked = git(["ls-files", "--others", "--exclude-standard"], capture=True)
    for rel in (untracked.stdout or "").splitlines():
        if rel.strip():
            status_paths.append(("A", rel.strip()))

    if not status_paths:
        print("session-commit: nothing to commit.")
        audit("session-commit", argv, 0, ack_gated, allow_destructive, reason="nothing-to-commit")
        sys.exit(0)

    paths = [p for _, p in status_paths]

    # Pre-flight pattern blocker (Class A replacement for Ralph): loud,
    # non-zero, BEFORE anything is staged.
    blocks = cc.preflight_blocks(paths)
    if blocks:
        refuse("session-commit", argv, 8,
               "refused: pre-flight blocked forbidden artifact(s):\n  " +
               "\n  ".join(f"{p} ({why})" for p, why in blocks[:20]) +
               "\nDelete or gitignore these before committing; never stage them.",
               reason="preflight-forbidden-pattern")

    # Screenshot/media rule: never stage a deletion of image/media files
    # from Class A content folders.
    media = cc.media_deletions(status_paths)
    if media:
        refuse("session-commit", argv, 9,
               "refused: media file deletion(s) would be staged:\n  " +
               "\n  ".join(media[:20]) +
               "\nNever delete image/media files from project folders during session commits"
               " (feedback_dont_delete_screenshots). Restore them, or delete and commit"
               " deliberately via the standard path with David's approval.",
               reason="media-deletion")

    # Risk classifier: ANY non-Class-A path poisons the fast lane.
    cls, offenders = cc.classify_changeset(paths)
    if cls != "A":
        gated = [p for p, c in offenders if c == "B"]
        other = [p for p, c in offenders if c == "other"]
        msg = "refused: changeset is not Class A; the session-commit fast lane only carries routine churn.\n"
        if gated:
            msg += "Gated (Class B, needs the standard path with --ack-gated):\n  " + "\n  ".join(gated[:20]) + "\n"
        if other:
            msg += "Unclassified (not fast-lane content; route via standard add/commit):\n  " + "\n  ".join(other[:20]) + "\n"
        msg += "Commit Class B separately from Class A churn so the system-change audit trail stays isolated."
        refuse("session-commit", argv, 4, msg.rstrip(), reason="not-class-a")

    # Credential scan over the full pending diff plus untracked contents.
    # Run-output carve-outs are excluded from the blocking scan (machine-
    # generated eval archives) and checked warn-only instead.
    diff = git(["diff", "HEAD", "--"] + carveout_pathspecs(), capture=True)
    scanned = (diff.stdout or "")[:200_000]
    exempt_scanned = ""
    for status, rel in status_paths:
        if status != "A":
            continue
        try:
            content = (Path.cwd() / rel).read_text(errors="replace")[:200_000]
        except OSError:
            continue
        if is_carveout_path(rel):
            exempt_scanned += content
        else:
            scanned += content
    warn_carveout_secrets(exempt_scanned, "session-commit")
    hits = scan_secrets(scanned)
    if hits:
        refuse("session-commit", argv, 5,
               "refused: credential-shaped content in pending changes: " + ", ".join(hits) +
               "\nSTOP. Surface to David immediately.", reason="secrets-session-commit")

    if dry_run:
        print(f"session-commit DRY RUN: would stage and commit {len(paths)} Class A file(s):")
        for p in paths[:40]:
            print(f"  {p}")
        if len(paths) > 40:
            print(f"  ... ({len(paths) - 40} more)")
        print(f"message: {message}")
        audit("session-commit", argv, 0, ack_gated, allow_destructive, reason="dry-run")
        sys.exit(0)

    add = git(["add", "-A"])
    if add.returncode != 0:
        audit("session-commit", argv, add.returncode, ack_gated, allow_destructive, reason="add-failed")
        sys.exit(add.returncode)
    result = git(["commit", "-m", message])
    audit("session-commit", argv, result.returncode, ack_gated, allow_destructive)
    sys.exit(result.returncode)


def classify_cli(argv):
    """Expose the risk classifier for inspection and tests:
    `ies-git classify <path>...` prints one `path: CLASS` line per path."""
    if not argv:
        die("usage: python3 skills/git/scripts/ies-git classify <path> [<path>...]")
    names = {"A": "A (routine, fast lane)", "B": "B (gated)", "other": "other (standard path)"}
    for p in argv:
        c = cc.classify_path(p)
        print(f"{p}: {names[c]}")


def die(msg: str, code: int = 1) -> "None":
    print(msg, file=sys.stderr)
    sys.exit(code)


def git(args, capture=False):
    """Run one git command via argv list, never a shell."""
    if capture:
        return subprocess.run(["git", *args], capture_output=True, text=True)
    return subprocess.run(["git", *args])


def audit(verb, argv, exit_code, ack_gated, allow_destructive, refused=False, reason=None):
    """Append one JSON line per operation or policy refusal to the untracked
    spool (folded into the tracked AUDIT_LOG at the next `add` harvest).
    Truncate long -m payloads. Refusals are audited with refused=true so the
    log doubles as continuously-accumulating bypass-attempt evidence."""
    safe_argv = []
    for a in argv:
        if len(a) > 120:
            safe_argv.append(a[:117] + "...")
        else:
            safe_argv.append(a)
    entry = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "via": "ies-git",
        "claude_session": os.environ.get("CLAUDECODE") == "1",
        "verb": verb,
        "args": safe_argv,
        "ack_gated": ack_gated,
        "allow_destructive": allow_destructive,
        "exit_code": exit_code,
        "refused": refused,
    }
    if reason:
        entry["reason"] = reason[:200]
    try:
        AUDIT_SPOOL.parent.mkdir(parents=True, exist_ok=True)
        with open(AUDIT_SPOOL, "a") as f:
            f.write(json.dumps(entry) + "\n")
    except OSError as e:  # the audit log must never block a git operation
        print(f"Warning: could not append git-ops audit spool: {e}", file=sys.stderr)


def harvest_audit():
    """Fold the untracked spool into the tracked AUDIT_LOG.

    Called at the start of `add` operations only: the harvested lines land in
    the working tree right before staging, so they are staged (and committed)
    by that same add instead of leaving the tracked log dirty. Never blocks a
    git operation."""
    try:
        if not AUDIT_SPOOL.is_file():
            return
        data = AUDIT_SPOOL.read_text()
        if not data.strip():
            AUDIT_SPOOL.unlink()
            return
        AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(AUDIT_LOG, "a") as f:
            f.write(data if data.endswith("\n") else data + "\n")
        AUDIT_SPOOL.unlink()
    except OSError as e:
        print(f"Warning: could not harvest git-ops audit spool: {e}", file=sys.stderr)


def refuse(verb, argv, code, msg, ack_gated=False, allow_destructive=False, reason=None):
    """Audit a policy refusal, then exit. Every blocked attempt lands in the
    audit log (refused=true) before the refusal message reaches stderr."""
    audit(verb, argv, code, ack_gated, allow_destructive, refused=True, reason=reason or msg.splitlines()[0])
    print(msg, file=sys.stderr)
    sys.exit(code)


def load_allowlist():
    """Exact literals subtracted before pattern matching (fake-by-construction
    strings only; see secret-allowlist.txt). Missing file = empty allowlist."""
    try:
        lines = ALLOWLIST_PATH.read_text().splitlines()
    except OSError:
        return []
    return [l.strip() for l in lines if l.strip() and not l.strip().startswith("#")]


def scan_secrets(diff_text, deletions_exempt=True):
    """Scan diff text (or raw file text with deletions_exempt=False) for
    credential-shaped content.

    Line-aware (err-20261018): only lines that would be ADDED to the repo can
    produce a refusal. Diff deletion lines ('-', not '---') and context lines
    (space-prefixed) are not additions: deletions are checked against the
    literal-value patterns only and warned on stderr (a deleted line can still
    reveal a real secret value in the diff text, but it is already in git
    history — surface it, don't block on it); context lines are skipped
    entirely. Raw file text (untracked file contents) passes
    deletions_exempt=False so every line scans as an addition, since a raw
    '- bullet' or '---' frontmatter line is content, not a diff marker."""
    for literal in load_allowlist():
        diff_text = diff_text.replace(literal, "")
    hits = []
    for line in diff_text.splitlines():
        if line.startswith("---") or line.startswith("+++"):
            continue  # diff file headers
        is_deletion = line.startswith("-")
        is_context = line.startswith(" ")
        if deletions_exempt and (is_deletion or is_context):
            if is_deletion:
                for pat in SECRET_VALUE_PATTERNS:
                    m = pat.search(line)
                    if m:
                        print(f"warn: deleted line may reveal a literal secret value ({m.group(0)[:20]}...); "
                              "already in git history — consider rotating it.", file=sys.stderr)
                        break
            continue
        body = line[1:] if (deletions_exempt and line[:1] == "+") else line
        for pat in SECRET_PATTERNS:
            m = pat.search(body)
            if m:
                hits.append(m.group(0)[:20] + "...")
                break
    return hits


# Run-output carve-out exemption (err-20261018T223936 follow-up): records under
# the machine-generated carve-outs legitimately quote test fixtures and the
# scanner's own refusal messages, so blocking on them accreted allowlist
# entries case by case. They are excluded from the blocking scan and checked
# warn-only instead. Single source of truth: the classifier's
# CLASS_A_SYSTEM_CARVEOUTS, so the scanner's exemption can never drift from
# the classifier's carve-out definition.
def carveout_pathspecs():
    """Pathspec excludes for the run-output carve-outs, for `git diff --`."""
    return [f":(exclude){c}" for c in cc.CLASS_A_SYSTEM_CARVEOUTS]


def is_carveout_path(rel):
    """True for repo-relative paths inside the run-output carve-outs."""
    return rel.startswith(cc.CLASS_A_SYSTEM_CARVEOUTS)


def warn_carveout_secrets(text, label):
    """Known-prefix literal check over exempted carve-out content. Warn-only:
    a genuinely leaked real key shape in an eval archive surfaces on stderr
    to a human rather than passing silently, without blocking the commit."""
    if not text:
        return
    for pat in SECRET_VALUE_PATTERNS:
        m = pat.search(text)
        if m:
            print(f"warn: {label}: run-output carve-out content may contain a literal "
                  f"secret value ({m.group(0)[:20]}...): machine-generated archive, not "
                  "blocked — verify it and consider rotating it.", file=sys.stderr)
            break


def main():
    argv = list(sys.argv[1:])
    ack_gated = "--ack-gated" in argv
    ack_root_files = "--ack-root-files" in argv
    allow_destructive = "--allow-destructive" in argv
    argv = [a for a in argv if a not in ("--ack-gated", "--ack-root-files", "--allow-destructive")]

    if not argv:
        die(USAGE)

    verb = argv[0]

    if verb == "status":
        refuse(verb, argv, 1, STATUS_REFUSAL)

    if verb == "session-commit":
        session_commit(argv[1:], ack_gated, allow_destructive)

    if verb == "classify":
        classify_cli(argv[1:])
        sys.exit(0)

    # Destructive policy (pre-execution, so nothing runs on refusal)
    if verb == "push" and any(f in argv for f in PUSH_FORCE_FLAGS):
        refs = [a for a in argv if not a.startswith("-")]
        if any(r == "main" or r.startswith("main:") or r.endswith(":main") for r in refs):
            refuse(verb, argv, 3, "refused: never force push to main (skills/git/SKILL.md). David must do this himself.", allow_destructive=allow_destructive, reason="force-push-to-main")
        if not allow_destructive:
            refuse(verb, argv, 3, "refused: force push needs --allow-destructive and David's explicit request (personal feature branches only).", reason="force-push-without-flag")
    if verb in DESTRUCTIVE_SUBCOMMANDS and not allow_destructive:
        refuse(verb, argv, 3, f"refused: `git {verb}` is destructive. Add --allow-destructive if David approved it directly.", reason=f"destructive-{verb}")

    if verb == "commit":
        messages = [argv[i + 1] for i, a in enumerate(argv) if a == "-m" and i + 1 < len(argv)]
        if not messages:
            refuse(verb, argv, 1, "refused: commit needs -m (no interactive editor in agent sessions).", ack_gated=ack_gated, reason="commit-without-m")
        if not COMMIT_LINT.match(messages[0]):
            refuse(verb, argv, 1,
                "refused: commit message fails Conventional Commits lint.\n"
                "Required: <type>(<scope>)?: lowercase imperative description, no trailing period\n"
                "Types: feat|fix|chore|docs|refactor|perf|test|revert\n"
                f"Got: {messages[0][:100]}",
                ack_gated=ack_gated, reason="commit-lint")
        staged = git(["diff", "--staged", "--name-only"], capture=True)
        staged_files = [l for l in staged.stdout.splitlines() if l.strip()]
        gated = [f for f in staged_files if f.startswith(GATED_DIRS)]
        if gated and not ack_gated:
            refuse(verb, argv, 4,
                "refused: gated directories changed and --ack-gated is not set.\n"
                "Per the pre-flight gate: gated-dir work must be Rigby-built this session.\n"
                "Changed gated files:\n  " + "\n  ".join(gated[:20]) +
                ("\n  ..." if len(gated) > 20 else "") +
                "\nRe-run with --ack-gated to proceed consciously.",
                reason="gated-dirs-unacked")
        lock_staged = [f for f in staged_files if f.split("/")[-1].startswith(".~lock") and f.endswith("#")]
        if lock_staged:
            refuse(verb, argv, 6,
                "refused: Office lock file(s) staged: " + ", ".join(lock_staged[:10]) +
                "\nThese are live-document lock artifacts (OneDrive-synced while a workbook is open),"
                " never commit content. Unstage them (git rm --cached via this wrapper) and add the"
                " .~lock.*# pattern to .gitignore if missing (see err-20261008T225136-RWH7B6).",
                ack_gated=ack_gated, reason="office-lock-file-staged")
        # Run-output carve-outs are excluded from the blocking scan
        # (machine-generated eval archives) and checked warn-only instead.
        staged_diff = git(["diff", "--staged", "--"] + carveout_pathspecs(), capture=True)
        hits = scan_secrets((staged_diff.stdout or "")[:200_000])
        carveout_staged = [f for f in staged_files if is_carveout_path(f)]
        if carveout_staged:
            exempt_diff = git(["diff", "--staged", "--"] + carveout_staged, capture=True)
            warn_carveout_secrets((exempt_diff.stdout or "")[:200_000], "commit")
        if hits:
            refuse(verb, argv, 5, "refused: credential-shaped content in staged diff: " + ", ".join(hits) + "\nSTOP. Surface to David immediately.", ack_gated=ack_gated, reason="secrets-staged")
        root_staged = [f for f in staged_files if "/" not in f and f not in CANONICAL_ROOT]
        if root_staged and not ack_root_files:
            refuse(verb, argv, 7,
                "refused: non-canonical root-level file(s) staged: " + ", ".join(root_staged[:10]) +
                "\nThe repo root has a canonical entry set (see CANONICAL_ROOT in this wrapper)."
                " Root-level files are usually misplaced deliverables: decide their proper folder,"
                " move them, then commit; or re-run with --ack-root-files to proceed consciously.",
                ack_gated=ack_gated, reason="non-canonical-root-entry")

    if verb == "add":
        # Fold the audit spool into the tracked log BEFORE staging, so the
        # harvested lines are staged (and committed) by this same add and the
        # tracked log is never dirty by construction.
        harvest_audit()
        paths = [a for a in argv[1:] if not a.startswith("-")]
        # Run-output carve-outs are excluded from the blocking scan
        # (machine-generated eval archives) and checked warn-only instead,
        # so quoting fixtures there never accretes allowlist entries.
        scan_paths = [p for p in paths if not is_carveout_path(p)]
        carveout_paths = [p for p in paths if is_carveout_path(p)]
        if scan_paths:
            diff = git(["diff", "--"] + scan_paths, capture=True)
            scanned = (diff.stdout or "")[:200_000]
        elif paths:
            scanned = ""  # only carve-out paths given: nothing blocking to scan
        else:
            diff = git(["diff", "--"] + carveout_pathspecs(), capture=True)
            scanned = (diff.stdout or "")[:200_000]
        # `git diff` shows nothing for untracked files, so read untracked
        # targets directly (capped) or the add-scan silently scans nothing.
        # Raw file text scans with deletions_exempt=False: its lines are all
        # additions, and '- bullet'/'---' frontmatter lines are content, not
        # diff markers.
        raw_scanned = ""
        exempt_raw = ""
        untracked = git(["ls-files", "--others", "--exclude-standard", "--"] + (paths if paths else []), capture=True)
        for rel in (untracked.stdout or "").splitlines():
            if not rel.strip():
                continue
            try:
                content = (Path.cwd() / rel).read_text(errors="replace")[:200_000] + "\n"
            except OSError:
                continue
            if is_carveout_path(rel):
                exempt_raw += content
            else:
                raw_scanned += content
        if carveout_paths:
            exempt_diff = git(["diff", "--"] + carveout_paths, capture=True)
            exempt_raw += (exempt_diff.stdout or "")[:200_000]
        warn_carveout_secrets(exempt_raw, "add")
        hits = scan_secrets(scanned) + scan_secrets(raw_scanned, deletions_exempt=False)
        if hits:
            refuse(verb, argv, 5, "refused: credential-shaped content in the diff being staged: " + ", ".join(hits) + "\nSTOP. Surface to David immediately.", reason="secrets-add")

    result = git(argv)
    audit(verb, argv, result.returncode, ack_gated, allow_destructive)
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
